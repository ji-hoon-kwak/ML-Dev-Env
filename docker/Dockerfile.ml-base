# pia/ml-base — AI(ML) 개발 공용 베이스 이미지 (무거운 부분 전부).
#
# admin 이 scripts/build_ml_base.sh 로 **딱 한 번** 빌드한다
# (environment.ml.yml 이 바뀔 때만 다시). 개발자별 이미지는 이 위에 useradd 한 줄만
# 얹으므로 발급이 항상 수 초에 끝난다 — build cache 유무와 무관하게.
#
# 환경 관리자는 conda (팀 합의 2026-08-14). Anaconda 본사 리포 상용 라이선스
# 이슈를 피하기 위해 Miniforge(conda-forge 기본)를 쓴다.

FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

# --- OS 패키지 ---
# libgl1/libglib2.0-0: opencv-python 이 headless 서버에서 import 되려면 필요
# openssh-server: ⭐ 개발자가 '호스트가 아니라 이 컨테이너'로 직접 SSH 접속(격리 접속 모델).
# redis-server / postgresql: 개인 테스트 저장소를 컨테이너 안 로컬 프로세스로(devstores).
# node/npm: ⭐ conda 가 아니라 시스템(/usr/bin, NodeSource)에 설치 → conda env 활성화와
#   무관하게 기본 PATH 에서 node/npm/corepack(pnpm) 사용 가능. (pf-base 와 동일 방식)
RUN apt-get update && apt-get install -y --no-install-recommends \
        sudo git wget curl ca-certificates gnupg openssh-client openssh-server \
        redis-server postgresql postgresql-contrib \
        libgl1 libglib2.0-0 tmux htop vim \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && corepack enable \
    && rm -rf /var/lib/apt/lists/*

# --- Miniforge (conda) ---
RUN wget -qO /tmp/miniforge.sh \
        "https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh" \
    && bash /tmp/miniforge.sh -b -p /opt/conda \
    && rm /tmp/miniforge.sh

# --- mlteam 그룹 + 기본 conda env (dev) ---
# MLTEAM_GID 는 호스트 mlteam GID 와 맞춘다(build_ml_base.sh 가 주입). conda 트리를
# root:mlteam + group-writable 로 두면 mlteam 소속 개발자가 자기 컨테이너 안에서
# pip/conda install 가능(copy-on-write 라 다른 개발자에겐 영향 없음).
ARG MLTEAM_GID=2000
COPY environment.ml.yml /opt/project/environment.yml
RUN groupadd -g "${MLTEAM_GID}" mlteam \
    && /opt/conda/bin/conda env create -f /opt/project/environment.yml \
    && /opt/conda/bin/conda clean -afy \
    && chown -R root:"${MLTEAM_GID}" /opt/conda \
    && chmod -R g+w /opt/conda \
    && mkdir -p /workspace && chown root:"${MLTEAM_GID}" /workspace && chmod 2775 /workspace

# 홈은 호스트 볼륨으로 덮이므로 이미지의 ~/.bashrc conda init 은 무효.
# 활성화는 (a) 아래 PATH 기본값 + (b) provision_ml.sh 의 호스트 ~/.bashrc snippet.
ENV PATH=/opt/conda/envs/dev/bin:/opt/conda/bin:$PATH

# ⭐ /etc/environment — 컨테이너 sshd 세션은 이미지 ENV 를 안 물려받고, ~/.bashrc
#    conda 스니펫은 '대화형' 셸만 커버한다. VS Code Python 확장 호스트(비대화형)가
#    conda python 을 자동 탐지하려면 PAM(pam_env)이 읽는 /etc/environment 에 PATH 를
#    박아야 한다. (안 그러면 "Python 을 찾을 수 없습니다" → uv 설치 유도 팝업)
RUN printf 'PATH=/opt/conda/envs/dev/bin:/opt/conda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin\n' > /etc/environment

# --- sshd (컨테이너 직결 접속) + devstores (컨테이너 안 개인 저장소) ---
# 호스트 sshd 가 아니라 컨테이너 sshd 로 붙으므로 개발자는 호스트 docker 접근이 필요없다
# → 호스트 daemon 오염 경로(piascope-jordan-* 류) 자체가 사라진다.
# ⭐ 이 블록을 무거운 conda 레이어 '뒤'에 둔다. 레이어 캐시는 위→아래로만 유효하므로,
#    자주 바뀌는 sshd 설정·키 정책을 앞에 두면 그 변경이 밑의 conda env 레이어 캐시까지
#    무효화해 매번 conda solve+대량 다운로드가 다시 돈다. 뒤로 빼면 sshd 만 다시 굽는다.
# ⭐ 호스트 키는 이미지에 굽지 않는다(예전 `ssh-keygen -A`). 이미지 레이어에 키가 살면
#    이미지 수명 = 키 수명이라, 재빌드/prune 마다 새 랜덤 키가 나와 클라이언트
#    known_hosts 를 깨뜨린다(REMOTE HOST IDENTIFICATION HAS CHANGED). 대신 provision_*.sh
#    이 개발자별 호스트 키를 '최초 1회' 발급해 /etc/ssh/keys 로 read-only 마운트한다 →
#    재빌드·재발급에도 호스트 키(신원)가 불변. sshd_config 의 HostKey 가 그 경로를 가리킨다.
#    (마운트 없이 이 이미지만 실행하면 sshd 는 키가 없어 기동 실패 = 의도된 loud fail.)
COPY sshd_config_42dev.conf /etc/ssh/sshd_config.d/42dev.conf
COPY devstores.sh /usr/local/bin/devstores
RUN mkdir -p /run/sshd /etc/ssh/keys \
    && chmod 0755 /usr/local/bin/devstores

# pid1 = sshd(포그라운드). 개발자는 컨테이너 sshd 로 직접 들어와 작업한다.
# (예전 `sleep infinity` + 호스트 `docker exec` 모델은 호스트 docker 접근을 요구했다 →
#  그게 오염 경로였다. 이제 호스트 docker 없이 접속 가능.)
CMD ["/usr/sbin/sshd", "-D", "-e"]
