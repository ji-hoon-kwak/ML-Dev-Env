# pia/pf-base — 플랫폼(BE/FE) 개발 공용 베이스 이미지.
#
# AI 베이스(pia/ml-base)와 달리 **CUDA·torch·GPU 가 없다** — 플랫폼 개발자는
# 모델을 직접 돌리지 않고 AI 서비스(scene/fg/trace)를 HTTP 로 호출할 뿐이다.
# 대신 FE(Next.js)용 **Node.js** 가 들어간다.
#
# admin 이 scripts/build_pf_base.sh 로 1회 빌드(environment.pf.yml 변경 시 재실행).
# 개발자별 이미지는 이 위에 useradd 만 얹는다(Dockerfile.pf · ~1초).

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# --- OS 패키지 ---
RUN apt-get update && apt-get install -y --no-install-recommends \
        sudo git wget curl ca-certificates openssh-client build-essential \
        tmux htop vim \
    && rm -rf /var/lib/apt/lists/*

# --- Miniforge (conda) — Anaconda 상용 리포 회피(conda-forge) ---
RUN wget -qO /tmp/miniforge.sh \
        "https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh" \
    && bash /tmp/miniforge.sh -b -p /opt/conda \
    && rm /tmp/miniforge.sh

# --- mlteam 그룹 + 기본 env(dev): python + nodejs ---
# conda 트리를 root:mlteam group-writable 로 → 개발자가 자기 컨테이너 안에서
# pip/conda/npm 설치 가능(copy-on-write 라 다른 개발자에겐 영향 없음).
ARG MLTEAM_GID=2000
COPY environment.pf.yml /opt/project/environment.yml
RUN groupadd -g "${MLTEAM_GID}" mlteam \
    && /opt/conda/bin/conda env create -f /opt/project/environment.yml \
    && /opt/conda/bin/conda clean -afy \
    && chown -R root:"${MLTEAM_GID}" /opt/conda \
    && chmod -R g+w /opt/conda \
    && mkdir -p /workspace && chown root:"${MLTEAM_GID}" /workspace && chmod 2775 /workspace

ENV PATH=/opt/conda/envs/dev/bin:/opt/conda/bin:$PATH

CMD ["sleep", "infinity"]
